@page "/reports"

<div class="p-6 max-w-7xl mx-auto space-y-6 report-container">
    <!-- Header & Controls (Hidden during print) -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4 no-print">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-800">Attendance & Activity Reports</h1>
            <p class="text-sm text-gray-500 mt-1">Filter, review, export detailed logs, or generate emergency headcount sheets.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button @onclick="PrintReport" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-2">
                🖨️ Print / Emergency Report
            </button>
            <button @onclick="ExportToExcel" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-2">
                📊 Export Detailed .XLS
            </button>
        </div>
    </div>

    <!-- Filters Section (Hidden during print) -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 grid grid-cols-1 md:grid-cols-5 gap-4 items-end no-print">
        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Search Name / ID</label>
            <input type="text" @bind="SearchQuery" @bind:event="oninput" placeholder="Search..." 
                   class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white text-gray-800 font-medium placeholder-gray-400" />
        </div>

        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Role Filter</label>
            <select @bind="SelectedRole" class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white text-gray-800 font-medium">
                <option value="All" class="bg-white text-gray-800">All Roles</option>
                <option value="Student" class="bg-white text-gray-800">Student</option>
                <option value="Teacher" class="bg-white text-gray-800">Teacher</option>
                <option value="Staff" class="bg-white text-gray-800">Staff</option>
            </select>
        </div>

        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Start Date</label>
            <input type="date" @bind="StartDate" 
                   class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white text-gray-800 font-medium" />
        </div>

        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">End Date</label>
            <input type="date" @bind="EndDate" 
                   class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white text-gray-800 font-medium" />
        </div>

        <div>
            <button @onclick="LoadReports" class="w-full px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm transition-colors shadow-sm">
                Filter
            </button>
        </div>
    </div>

    <!-- Reports Table Container -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-4 border-b bg-gray-50/50 flex justify-between items-center">
            <span class="font-bold text-gray-700">Total Logs Found: <span class="text-indigo-600">@ReportList.Count</span></span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-100/60 text-xs font-bold uppercase tracking-wider text-gray-500 border-b">
                        <th class="p-4">School ID</th>
                        <th class="p-4">Full Name</th>
                        <th class="p-4">Role</th>
                        <th class="p-4">Level / Dept / Course / Year</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Date</th>
                        <th class="p-4">Time In</th>
                        <th class="p-4">Time Out</th>
                        <th class="p-4">Punctuality</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-gray-400">Loading attendance reports...</td>
                        </tr>
                    }
                    else if (ReportList.Any())
                    {
                        @foreach (var report in ReportList)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="p-4 font-mono font-bold text-gray-800">@report.SchoolId</td>
                                <td class="p-4 font-bold text-gray-900">@report.FullName</td>
                                <td class="p-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold @GetRoleBadgeClass(report.Role)">
                                        @report.Role
                                    </span>
                                </td>
                                <td class="p-4 text-gray-600 text-xs space-y-0.5">
                                    <div>Lvl: @(string.IsNullOrEmpty(report.EducationalLevel) ? "—" : report.EducationalLevel)</div>
                                    <div>Dept: @(string.IsNullOrEmpty(report.Department) ? "—" : report.Department)</div>
                                    <div>Course: @(string.IsNullOrEmpty(report.Course) ? "—" : report.Course)</div>
                                    <div>Yr: @(string.IsNullOrEmpty(report.YearLevel) ? "—" : report.YearLevel)</div>
                                </td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-md text-xs font-bold @GetStatusBadgeClass(report.Status)">
                                        @report.Status
                                    </span>
                                </td>
                                <td class="p-4 text-gray-600">@report.LogDate</td>
                                <td class="p-4 font-mono text-emerald-600 font-semibold">@(string.IsNullOrEmpty(report.TimeIn) ? "—" : report.TimeIn)</td>
                                <td class="p-4 font-mono text-gray-500">@(string.IsNullOrEmpty(report.TimeOut) ? "—" : report.TimeOut)</td>
                                <td class="p-4 font-semibold text-gray-700">@report.Punctuality</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-gray-400">No attendance reports found matching your criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string GetRoleBadgeClass(string role) => role switch
    {
        "Student" => "bg-blue-100 text-blue-800",
        "Teacher" => "bg-purple-100 text-purple-800",
        "Staff" => "bg-emerald-100 text-emerald-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "ON Campus" or "On Campus" => "bg-emerald-100 text-emerald-800",
        "OFF Campus" or "Off Campus" => "bg-amber-100 text-amber-800",
        _ => "bg-gray-100 text-gray-800"
    };
}