@using System.Net.Http.Json
@using AttendanceSystem.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<EditForm Model="Model" OnValidSubmit="HandleVisitorRegistration">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="p-3 mb-4 rounded-xl text-sm font-semibold @(IsSuccess ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")" role="alert">
            @StatusMessage
        </div>
    }

    <div class="space-y-4">
        <!-- NFC Tag Field -->
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">NFC Tag UID</label>
            <div class="flex gap-2">
               <input @ref="nfcInputRef" type="text" @bind="Model.NfcTagId" @bind:event="oninput" 
       @onkeydown="HandleKeyDown" placeholder="Tap card with USB reader..." required 
       class="w-full p-3 rounded-xl border border-slate-300 font-mono text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            </div>
        </div>

        <!-- Visitor Name -->
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Full Name</label>
            <input type="text" @bind="Model.Name" placeholder="e.g. John Doe" required 
                   class="w-full p-3 rounded-xl border border-slate-300 text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>

        <!-- Visitor Address -->
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Address</label>
            <input type="text" @bind="Model.Address" placeholder="e.g. 123 Main St, Anytown" 
                   class="w-full p-3 rounded-xl border border-slate-300 text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>

        <!-- Purpose of Visit -->
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Purpose of Visit</label>
            <textarea @bind="Model.PurposeOfVisit" rows="3" placeholder="e.g. Meeting with HR Department" 
                      class="w-full p-3 rounded-xl border border-slate-300 text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
        </div>

        <div class="pt-4 flex justify-end gap-2 border-t">
            <button type="button" @onclick="CloseModal" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl text-sm transition-all">Close</button>
            <button type="submit" disabled="@IsSubmitting" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-sm shadow transition-all">
                @(IsSubmitting ? "Registering..." : "Register Visitor")
            </button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }

    private VisitorRegistrationModel Model { get; set; } = new();
    private ElementReference nfcInputRef;
    private bool IsSubmitting { get; set; }
    private string? StatusMessage { get; set; }
    private bool IsSuccess { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await nfcInputRef.FocusAsync();
        }
    }

    private async Task HandleVisitorRegistration()
    {
        IsSubmitting = true;
        StatusMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost/attendance-api/visitor_register.php", Model);
            var responseString = await response.Content.ReadAsStringAsync();

            if (string.IsNullOrWhiteSpace(responseString))
            {
                throw new Exception("Received empty response from PHP server. Check your database connection settings.");
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<ApiResponse>(responseString, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            IsSuccess = result?.Success ?? false;
            StatusMessage = result?.Message ?? "Unknown server response.";

            if (IsSuccess)
            {
                Model = new(); // Reset form
                await Task.Delay(1000);
                if (OnSuccess.HasDelegate) await OnSuccess.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            IsSuccess = false;
            StatusMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task CloseModal()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public class ApiResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
{
    if (e.Key == "Enter" && !IsSubmitting)
    {
        await HandleVisitorRegistration();
    }
}
}