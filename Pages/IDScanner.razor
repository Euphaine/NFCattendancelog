@page "/scanner"
@using AttendanceSystem.Models

<PageTitle>Attendance Terminal</PageTitle>

<div class="min-h-[85vh] flex flex-col items-center justify-center space-y-6">

    <!-- Terminal Header Card -->
    <div class="w-full max-w-xl p-8 rounded-2xl bg-slate-900 border border-slate-800 text-center shadow-2xl space-y-4">
        
        <div class="flex justify-center items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-extrabold tracking-widest uppercase text-emerald-400">Terminal Active</span>
        </div>

        <h1 class="text-3xl font-black text-white tracking-tight">Tap ID / ATM Card</h1>
        <p class="text-slate-400 text-sm">Mobile Web NFC or Desktop USB Reader supported.</p>

        <!-- Hidden / Auto-Focused Input Box for USB Readers -->
        <div class="pt-2">
            <input @ref="terminalInputRef" 
                   autofocus 
                   type="text" 
                   @bind="ScannedUid" 
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp" 
                   placeholder="Scan card here..." 
                   class="w-full p-3 rounded-xl bg-slate-800/80 border border-slate-700 text-center font-mono text-sm font-bold text-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all placeholder:text-slate-600" />
        </div>
    </div>

    <!-- Live Scanned User Profile Card -->
    @if (LastScannedUser != null)
    {
        <div class="w-full max-w-xl p-6 rounded-2xl bg-white border border-slate-200 shadow-xl transition-all duration-300 transform scale-100 space-y-4">
            
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-xl font-bold text-slate-700">
                        👤
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">@LastScannedUser.UserName</h2>
                        <p class="text-xs font-semibold text-slate-400">ID: @LastScannedUser.SchoolId • @LastScannedUser.Role</p>
                    </div>
                </div>

                <!-- Status Badges -->
                <div class="flex flex-col items-end gap-1">
                    <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider @(LastScannedUser.ActionStatus == "ENTRY" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                        @(LastScannedUser.ActionStatus == "ENTRY" ? "IN CAMPUS" : "OUT OF CAMPUS")
                    </span>

                    <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider @GetPunctualityStyle(LastScannedUser.Punctuality)">
                        @LastScannedUser.Punctuality
                    </span>
                </div>
            </div>

            <!-- Greeting Banner -->
            <div class="p-4 rounded-xl text-center font-bold text-sm @(LastScannedUser.ActionStatus == "EXIT" ? "bg-blue-50 text-blue-800 border border-blue-200" : "bg-emerald-50 text-emerald-800 border border-emerald-200")">
                @LastScannedUser.Message
            </div>

            <div class="flex justify-between items-center text-xs text-slate-400 pt-1">
                <span>@LastScannedUser.Department @(string.IsNullOrEmpty(LastScannedUser.YearLevel) ? "" : $"• {LastScannedUser.YearLevel}")</span>
                <span class="font-mono font-bold">Logged at @LastScannedUser.Timestamp</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ScanMessage))
    {
        <!-- Error / Unregistered Card Banner -->
        <div class="w-full max-w-xl p-4 rounded-xl text-center font-bold text-sm bg-rose-50 border border-rose-200 text-rose-800 shadow-md">
            @ScanMessage
        </div>
    }
</div>