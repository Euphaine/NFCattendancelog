@page "/logs"

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Header & Metrics Cards -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-extrabold text-gray-800">Security Guard Live Monitor</h1>
                <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> LIVE POLLING
                </span>
            </div>
            <p class="text-sm text-gray-500 mt-1">Real-time gate monitoring for entries and exits today.</p>
        </div>
        
        <div class="flex flex-col md:flex-row items-center gap-3 w-full md:w-auto">
            <!-- Search Bar -->
            <div class="w-full md:w-72">
                <input type="text" @bind="SearchQuery" @bind:event="oninput" placeholder="Search name or ID..." 
                       class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none text-sm bg-gray-50/50" />
            </div>

            <!-- Trigger Button for Visitor Registration Modal -->
            <button @onclick="OpenVisitorModal" class="w-full md:w-auto px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition-all flex items-center justify-center gap-2 text-sm whitespace-nowrap">
                🛡️ Register Visitor
            </button>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-100/60 text-xs font-bold uppercase tracking-wider text-gray-500 border-b">
                        <th class="p-4">School ID</th>
                        <th class="p-4">Name / Role</th>
                        <th class="p-4">Dept / Course / Year</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Date</th>
                        <th class="p-4">Time In</th>
                        <th class="p-4">Time Out</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (FilteredLogs.Any())
                    {
                        @foreach (var log in FilteredLogs)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <!-- School ID -->
                                <td class="p-4 font-mono font-bold text-gray-800">@log.SchoolId</td>
                                
                                <!-- Name / Role -->
                                <td class="p-4">
                                    <div class="font-bold text-gray-900">@log.FullName</div>
                                    <div class="text-xs text-gray-400">@log.Role</div>
                                </td>
                                
                                <!-- Dept / Course / Year / Educational Level -->
                                <td class="p-4 text-gray-600">
                                    @if (!string.IsNullOrEmpty(log.EducationalLevel))
                                    {
                                        <div class="font-medium text-gray-800">@log.EducationalLevel</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.Department) && log.Department != log.Course)
                                    {
                                        <div class="font-medium text-gray-800">@log.Department</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.Course))
                                    {
                                        <div class="text-xs text-gray-500">Course: @log.Course</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.YearLevel))
                                    {
                                        <div class="text-xs text-indigo-600 font-semibold">Year: @log.YearLevel</div>
                                    }
                                    @if (string.IsNullOrEmpty(log.EducationalLevel) && string.IsNullOrEmpty(log.Department) && string.IsNullOrEmpty(log.Course) && string.IsNullOrEmpty(log.YearLevel))
                                    {
                                        <span class="text-gray-400">N/A</span>
                                    }
                                </td>
                                
                                <!-- Status Badge Column -->
                                <td class="p-4">
                                    @if (log.TimeOut == "—" || log.Status == "ON Campus")
                                    {
                                        <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">🟢 ON Campus</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs font-bold">⚪ OFF Campus</span>
                                    }
                                </td>

                                <!-- Date Column -->
                                <td class="p-4 font-mono text-xs text-gray-600">
                                    @(string.IsNullOrEmpty(log.LogDate) ? "—" : log.LogDate)
                                </td>

                                <!-- Time In Column -->
                                <td class="p-4 font-mono text-xs text-emerald-700 font-semibold">
                                    @(string.IsNullOrEmpty(log.TimeIn) ? "—" : log.TimeIn)
                                </td>

                                <!-- Time Out Column -->
                                <td class="p-4 font-mono text-xs text-gray-500">
                                    @(string.IsNullOrEmpty(log.TimeOut) ? "—" : log.TimeOut)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-gray-400">No logs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Visitor Registration Modal Backdrop & Content -->
@if (IsVisitorModalOpen)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-extrabold text-lg text-gray-800 flex items-center gap-2">
                    🛡️ Campus Visitor Registration
                </h3>
                <button @onclick="CloseVisitorModal" class="text-gray-400 hover:text-gray-600 font-bold text-lg">✕</button>
            </div>

            <!-- Embedded Visitor Form Component -->
            <VisitorRegistrationForm />
        </div>
    </div>
}