@page "/logs"
@using AttendanceSystem.Models
@implements IDisposable

<div class="p-6 max-w-7xl mx-auto space-y-6">

    <!-- Header & Live Pulse -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-extrabold text-gray-800">Security Guard Live Monitor</h1>
                <span class="flex h-3 w-3 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">Live Polling</span>
            </div>
            <p class="text-sm text-gray-500 mt-1">Real-time gate monitoring for entries and exits today.</p>
        </div>

        <div class="flex items-center gap-3 text-sm font-semibold">
            <span class="text-gray-400">Search:</span>
            <input type="text" @bind="SearchQuery" @bind:event="oninput" placeholder="Search name or ID..." class="px-4 py-2 border rounded-xl focus:ring-2 focus:ring-blue-500 outline-none w-64" />
        </div>
    </div>

    <!-- Live Roll-Call Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gradient-to-br from-emerald-500 to-green-600 text-white p-6 rounded-2xl shadow-md flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider opacity-80">Currently ON Campus</p>
                <p class="text-4xl font-black mt-1">@Stats.OnCampus</p>
            </div>
            <span class="text-4xl">🏫</span>
        </div>

        <div class="bg-gradient-to-br from-amber-500 to-orange-600 text-white p-6 rounded-2xl shadow-md flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider opacity-80">Checked OFF Campus Today</p>
                <p class="text-4xl font-black mt-1">@Stats.OffCampus</p>
            </div>
            <span class="text-4xl">🚪</span>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Total Unique Users Today</p>
                <p class="text-4xl font-black text-gray-800 mt-1">@Stats.TotalToday</p>
            </div>
            <span class="text-4xl">👥</span>
        </div>
    </div>

    <!-- Live Logs Data Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-4 border-b bg-gray-50/50 flex justify-between items-center">
            <h2 class="font-bold text-gray-700">Recent Campus Activity</h2>
            <span class="text-xs text-gray-400 font-mono">Auto-refreshes every 2s</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-100/60 text-xs font-bold uppercase tracking-wider text-gray-500 border-b">
                        <th class="p-4">School ID</th>
                        <th class="p-4">Name / Role</th>
                        <th class="p-4">Department / Course</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Time IN</th>
                        <th class="p-4">Time OUT</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (FilteredLogs.Any())
                    {
                        @foreach (var log in FilteredLogs)
                        {
                            <tr class="hover:bg-blue-50/30 transition-colors">
                                <td class="p-4 font-mono font-bold text-gray-800">@log.SchoolId</td>
                                <td class="p-4">
                                    <div class="font-bold text-gray-900">@log.FullName</div>
                                    <div class="text-xs text-gray-400">@log.Role</div>
                                </td>
                                <td class="p-4 text-gray-600">
                                    <span>@(log.Course ?? log.Department ?? "N/A")</span>
                                </td>
                                <td class="p-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold tracking-wide @(log.Status == "ON Campus" ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-amber-100 text-amber-800 border border-amber-300")">
                                        ● @log.Status
                                    </span>
                                </td>
                                <td class="p-4 font-mono text-emerald-700 font-semibold">@log.FormattedTimeIn</td>
                                <td class="p-4 font-mono text-amber-700 font-semibold">@log.FormattedTimeOut</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-gray-400">
                                No scan logs found for today yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>