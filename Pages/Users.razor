@page "/users"
@inherits AttendanceSystem.Pages.UsersBase

<div class="p-6 max-w-7xl mx-auto space-y-6">

    <!-- Header & Search Controls -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-800">User Directory & Management</h1>
            <p class="text-sm text-gray-500 mt-1">View, search, update, or remove registered students, faculty, and staff.</p>
        </div>
        
        <a href="register" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition-all flex items-center gap-2 text-sm">
            ➕ Register New User
        </a>
    </div>

    <!-- Filters Bar -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-4 items-center justify-between">
        <!-- Search Input & Button grouped tightly together -->
        <div class="flex items-center gap-2 w-full md:w-[450px]">
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search by name, school ID, or NFC tag..." 
                   class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white text-gray-800 font-medium placeholder-gray-400" />
            <button @onclick="LoadUsers" class="px-5 py-2 bg-gray-800 hover:bg-gray-900 text-white font-bold rounded-xl text-sm transition-colors whitespace-nowrap shadow-sm">
                Search
            </button>
        </div>

        <!-- Filter Role with instant onchange behavior -->
        <div class="flex items-center gap-2 w-full md:w-auto justify-end">
            <label class="text-xs font-bold text-gray-500 uppercase tracking-wider">Filter Role:</label>
            <select @value="SelectedRole" @onchange="OnRoleChanged" class="px-4 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white text-gray-800 font-medium">
                <option value="All" class="bg-white text-gray-800">All Roles</option>
                <option value="Student" class="bg-white text-gray-800">Students</option>
                <option value="Teacher" class="bg-white text-gray-800">Teachers</option>
                <option value="Staff" class="bg-white text-gray-800">Staff</option>
            </select>
        </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-4 border-b bg-gray-50/50 flex justify-between items-center">
            <span class="font-bold text-gray-700">Total Users Found: <span class="text-indigo-600">@UserList.Count</span></span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-100/60 text-xs font-bold uppercase tracking-wider text-gray-500 border-b">
                        <th class="p-4">Photo</th>
                        <th class="p-4">School ID</th>
                        <th class="p-4">NFC Tag</th>
                        <th class="p-4">Full Name</th>
                        <th class="p-4">Role</th>
                        <th class="p-4">Dept / Course</th>
                        <th class="p-4">Level</th>
                        <th class="p-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="8" class="p-8 text-center text-gray-400">Loading users directory...</td>
                        </tr>
                    }
                    else if (UserList.Any())
                    {
                        @foreach (var user in UserList)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="p-4">
                                    @if (!string.IsNullOrEmpty(user.Photo))
                                    {
                                        <img src="http://localhost/attendance-api/uploads/@user.Photo" class="w-10 h-10 rounded-full object-cover shadow-sm border" alt="Photo" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-600">👤</div>
                                    }
                                </td>
                                <td class="p-4 font-mono font-bold text-gray-800">@user.SchoolId</td>
                                <td class="p-4 font-mono text-gray-500">@user.NfcTagId</td>
                                <td class="p-4 font-bold text-gray-900">@user.FirstName @user.LastName @user.Suffix</td>
                                <td class="p-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold @GetRoleBadgeClass(user.Role)">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="p-4 text-gray-600">
                                    <div>@(string.IsNullOrEmpty(user.Department) ? "—" : user.Department)</div>
                                    @if (!string.IsNullOrEmpty(user.Course))
                                    {
                                        <div class="text-xs text-gray-500">Course: @user.Course</div>
                                    }
                                </td>
                                <td class="p-4 text-gray-600">
                                    <div>@(string.IsNullOrEmpty(user.EducationalLevel) ? "—" : user.EducationalLevel)</div>
                                    @if (!string.IsNullOrEmpty(user.YearLevel))
                                    {
                                        <div class="text-xs text-indigo-600 font-semibold">@user.YearLevel</div>
                                    }
                                </td>
                                <td class="p-4 text-center flex justify-center gap-2">
                                    <button @onclick="() => OpenEditModal(user)" class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-600 font-bold rounded-lg text-xs transition-colors">
                                        ✏️ Edit
                                    </button>
                                    <button @onclick="() => DeleteUser(user.Id)" class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-lg text-xs transition-colors">
                                        🗑️ Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="p-8 text-center text-gray-400">No users found matching your criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
@if (IsEditing && EditingUser != null)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-extrabold text-lg text-gray-800">Edit User Details</h3>
                <button @onclick="CloseEditModal" class="text-gray-400 hover:text-gray-600 font-bold">✕</button>
            </div>

            <div class="space-y-3 max-h-[70vh] overflow-y-auto pr-1">
                <!-- Photo Update Section -->
                <div class="flex items-center gap-4 bg-gray-50 p-3 rounded-xl border">
                    <div>
                        @if (!string.IsNullOrEmpty(EditingUser.Photo))
                        {
                            <img src="http://localhost/attendance-api/uploads/@EditingUser.Photo" class="w-14 h-14 rounded-full object-cover shadow-sm border" />
                        }
                        else
                        {
                            <div class="w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-xl">👤</div>
                        }
                    </div>
                    <div class="flex-1">
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Change Photo (Optional)</label>
                        <InputFile OnChange="OnEditPhotoSelected" class="w-full text-xs text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100"/>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">School ID</label>
                        <input type="text" @bind="EditingUser.SchoolId" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">NFC Tag ID</label>
                        <input type="text" @bind="EditingUser.NfcTagId" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                </div>

                <div>
                    <label class="text-xs font-bold text-gray-500 mb-1 block">Role</label>
                    <select @bind="EditingUser.Role" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium">
                        <option value="Student" class="bg-white text-gray-800">Student</option>
                        <option value="Teacher" class="bg-white text-gray-800">Teacher</option>
                        <option value="Staff" class="bg-white text-gray-800">Staff</option>
                    </select>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">First Name</label>
                        <input type="text" @bind="EditingUser.FirstName" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Last Name</label>
                        <input type="text" @bind="EditingUser.LastName" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Suffix</label>
                        <input type="text" @bind="EditingUser.Suffix" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" placeholder="e.g. Jr." />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Department</label>
                        <input type="text" @bind="EditingUser.Department" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Educational Level</label>
                        <input type="text" @bind="EditingUser.EducationalLevel" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Course</label>
                        <input type="text" @bind="EditingUser.Course" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 mb-1 block">Year Level</label>
                        <input type="text" @bind="EditingUser.YearLevel" class="w-full px-3 py-2 border rounded-xl text-sm bg-white text-gray-800 font-medium" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-3 border-t">
                <button @onclick="CloseEditModal" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl text-sm">Cancel</button>
                <button @onclick="SaveUserChanges" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm">Save Changes</button>
            </div>
        </div>
    </div>
}