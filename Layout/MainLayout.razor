@inherits LayoutComponentBase

<div class="page flex min-h-screen @(IsDarkMode ? "bg-black text-gray-100" : "bg-gray-50 text-gray-900") transition-colors duration-300 relative overflow-x-hidden">

    <!-- Global Watermark Background Logo with AI Glow Effect -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0 @(IsDarkMode ? "opacity-[0.18]" : "opacity-[0.12]")">
        <img src="images/SCC-Dark.png" alt="Watermark Logo" class="ai-glow-logo w-[650px] h-[650px] object-contain select-none" />
    </div>

    <!-- Hover Trigger Zone & Sliding Sidebar Container -->
    <!-- Hover Trigger Zone & Sliding Sidebar Container -->
<div class="group peer fixed inset-y-0 left-0 z-50 flex items-center w-3 hover:w-64 transition-all duration-300">
    <!-- Visible Hover Hint Edge Badge -->
    <div class="absolute left-0 bg-gradient-to-r from-amber-500 to-blue-600 text-black font-bold text-[10px] px-1 py-3 rounded-r-xl shadow-lg opacity-80 group-hover:opacity-0 transition-opacity">
        <span class="writing-mode-vertical tracking-widest uppercase">Menu</span>
    </div>

        <!-- Actual Sidebar Drawer that slides out on hover -->
        <div class="h-full w-64 bg-zinc-950 border-r border-zinc-800 shadow-2xl transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col justify-between">
            <div class="sidebar flex-1 overflow-y-auto">
                <NavMenu />
            </div>

            <!-- Minimalist Circular Theme Toggle Button at the Bottom of the Nav Panel -->
            <div class="p-4 border-t border-zinc-800/80 flex items-center justify-between bg-zinc-900/50">
                <span class="text-xs text-zinc-400 font-medium">Appearance</span>
                <button @onclick="ToggleTheme" 
                        title="@(IsDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
                        class="w-10 h-10 rounded-full flex items-center justify-center border transition-all duration-300 shadow-sm @(IsDarkMode ? "bg-zinc-800 border-zinc-700 text-amber-400 hover:bg-zinc-700 hover:scale-105" : "bg-white border-gray-300 text-blue-900 hover:bg-gray-100 hover:scale-105")">
                    @if (IsDarkMode)
                    {
                        <!-- Sun Icon -->
                        <span class="text-base">☀️</span>
                    }
                    else
                    {
                        <!-- Moon Icon -->
                        <span class="text-base">🌙</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Main Body Content Area Layer (Clean header without buttons) -->
    <main class="flex-1 flex flex-col min-w-0 relative z-10">
        <header class="w-full p-4 border-b @(IsDarkMode ? "border-zinc-800 bg-black/50" : "border-gray-200 bg-white/50") backdrop-blur sticky top-0 z-40 flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-500/80 px-2">SCC Gate Portal</span>
        </header>

        <article class="content px-4 py-6 flex-1">
            @Body
        </article>
    </main>
</div>

@code {
    public static bool IsDarkMode { get; set; } = true;

    public void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
        StateHasChanged();
    }
}